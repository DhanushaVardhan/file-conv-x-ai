# Copy this file to .env, then fill in the keys you have. Every key is optional.
# Restart `node server.js` after changing it. The terminal lists which engines are on.

PORT=3000

# ---------------------------------------------------------------- Text AI
# Powers: AI Summary + questions, "Improve prompt", and the six built-in engines
# (Vector Illustrator, Shader Painter, Pixel Artist, Motion Graphics, Shader Film, Story Reel).
# Gemini has a free tier, and it is the only one that can watch whole videos and hear audio.
GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=            # https://platform.claude.com  (uses claude-haiku-5-5)
# OPENAI_API_KEY=               # https://platform.openai.com/api-keys (uses gpt-6-luna; also turns on GPT Image)
# TEXT_PROVIDER=gemini          # gemini | anthropic | openai  (picked automatically if unset)

# --------------------------------------------- Real image + video models
# fal.ai: FLUX.1 Schnell, Seedream 5 Lite (images) + Grok Imagine Video, Seedance 2.0, Veo 3.1 Fast (video)
FAL_KEY=                        # https://fal.ai/dashboard/keys
# Cloudflare Workers AI: Lucid Origin + FLUX.1 Schnell images, with a free daily allowance
CLOUDFLARE_ACCOUNT_ID=          # dash.cloudflare.com > any page > Account ID (right sidebar)
CLOUDFLARE_API_TOKEN=           # dash.cloudflare.com/profile/api-tokens > "Workers AI" template
# Replicate: FLUX.2 Pro + FLUX Schnell (images) + P-Video, MiniMax H3, Veo 3.1 Fast (video)
REPLICATE_API_TOKEN=            # https://replicate.com/account/api-tokens

# Optional extras:
# POLLINATIONS_API_KEY=         # sk_... from https://enter.pollinations.ai
# GEMINI_BILLING=on             # only if your Google AI project has billing: adds Nano Banana images + Gemini Omni video
# POLLINATIONS_FREE=off         # turns off the keyless low-res demo image engine
# IMAGE_PROVIDER=fal            # only offer one image provider: fal | cloudflare | replicate | openai | gemini | pollinations
# VIDEO_PROVIDER=fal            # only offer one video provider: fal | replicate | gemini
# MAX_UPLOAD_MB=1024            # biggest video/audio the server will pass to Gemini for summaries (Gemini max is 2 GB)

# ------------------------------------------------- Model names (rarely needed)
# Providers rename and retire models. If one disappears, put the new ID here.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_TEXT_MODEL=claude-haiku-5-5
# OPENAI_TEXT_MODEL=gpt-6-luna
# FAL_FLUX_MODEL=fal-ai/flux/schnell
# FAL_SEEDREAM_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image
# FAL_GROK_VIDEO_MODEL=xai/grok-imagine-video/text-to-video
# FAL_SEEDANCE_MODEL=bytedance/seedance-2.0/text-to-video
# FAL_VEO_MODEL=fal-ai/veo3.1/fast
# "Make it move" (start a clip from a picture) uses these image-to-video models:
# FAL_GROK_I2V_MODEL=xai/grok-imagine-video/image-to-video
# FAL_SEEDANCE_I2V_MODEL=bytedance/seedance-2.0/image-to-video
# FAL_VEO_I2V_MODEL=fal-ai/veo3.1/fast/image-to-video
# CLOUDFLARE_LUCID_MODEL=@cf/leonardo/lucid-origin
# CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
# REPLICATE_IMAGE_BEST=black-forest-labs/flux-2-pro
# REPLICATE_IMAGE_FAST=black-forest-labs/flux-schnell
# REPLICATE_VIDEO_FAST=prunaai/p-video
# REPLICATE_MINIMAX_MODEL=minimax/h3
# REPLICATE_VIDEO_BEST=google/veo-3.1-fast
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# POLLINATIONS_IMAGE_MODEL=flux

# --------------------------------------------- Protect your keys when public
# ACCESS_CODE=pick-a-secret-phrase   # visitors must type this before using AI
# AI_REQUESTS_PER_MINUTE=30          # per visitor
